# Copie para .env e substitua todos os valores abaixo.
# Use apenas letras e numeros na senha do MongoDB (ela compoe uma URI).
POSTGRES_PASSWORD=troque-por-uma-senha-forte
MONGO_PASSWORD=troque-por-outra-senha-forte
# Gere com: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(64))
JWT_SECRET_BASE64=troque-por-chave-aleatoria-em-base64
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Configure uma conta SMTP com autenticacao e STARTTLS.
# O remetente deve ser autorizado por essa conta (normalmente o mesmo e-mail).
SMTP_USERNAME=seu-email@example.com
SMTP_PASSWORD=sua-senha-ou-token-smtp
EMAIL_REMETENTE=seu-email@example.com
EMAIL_NOME_REMETENTE=Agendador de Tarefas
# Esta conta precisa existir na API de usuarios para o cron autenticar.
CRON_USUARIO_EMAIL=cron@example.com
CRON_USUARIO_SENHA=troque-por-senha-do-usuario-cron
CRON_HORARIO=0 0/1 * * * ?
CORS_ORIGIN=https://seu-frontend.example.com
BFF_PORT=8083
